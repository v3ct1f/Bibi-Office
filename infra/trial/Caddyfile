# HTTPS is automatic (Let's Encrypt). DOMAIN=localhost uses a local test certificate.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /id/* {
		# Keycloak admin console is not public; use ./office.sh (kcadm inside the container).
		@kcadmin path /id/admin /id/admin/*
		respond @kcadmin 404
		reverse_proxy keycloak:8080
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
