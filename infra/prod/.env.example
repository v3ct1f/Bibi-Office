# Office production settings. Copy to .env on the SERVER (infra/prod/make-env.sh does it and fills the secrets for you).
# NEVER commit the real .env and never paste its secrets in chat. Keep a copy in your password manager:
# SECRETS_KEY encrypts what Office stores for businesses; if it is lost, those stored secrets cannot be read again.

# ── Addresses ──
WEB_HOST=office.bibidesk.com
API_HOST=office-api.bibidesk.com
AUTH_HOST=office-auth.bibidesk.com
# The address people use for the app (links in emails, sign-in redirect). Change to https://bibidesk.com at cutover.
APP_URL=https://office.bibidesk.com
# Second allowed address for the web app (the root domain, ready for the cutover).
APP_URL_ALT=https://bibidesk.com
# Comma-separated list of addresses the web app may call the API from.
CORS_ORIGINS=https://office.bibidesk.com,https://bibidesk.com
# Receives HTTPS certificate warnings.
ACME_EMAIL=hello@bibidesk.com

# ── Who runs the program ──
# Verified email(s) of the program owner(s) on first start (afterwards managed in Program admin).
PLATFORM_ADMIN_EMAILS=vectiff@gmail.com
# Where "Contact support" messages go.
CONTACT_EMAIL=vectiff@gmail.com

# ── Generated by make-env.sh (do not invent these by hand) ──
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_RELAY_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KC_ADMIN_USER=bibi-admin
KC_ADMIN_PASSWORD=
OFFICE_ADMIN_CLIENT_SECRET=
API_KEY_PEPPER=
SECRETS_KEY=

# ── Email (Resend, the same service Bibi uses). Create an API key in Resend (sending access) and paste it here. ──
RESEND_API_KEY=
MAIL_FROM=Bibi Office <hello@bibidesk.com>
MAIL_SMTP_URL=smtps://resend:${RESEND_API_KEY}@smtp.resend.com:465
# The same account for the emails Keycloak sends (set-password, verify email).
KC_SMTP_HOST=smtp.resend.com
KC_SMTP_PORT=587
KC_SMTP_FROM=hello@bibidesk.com
KC_SMTP_USER=resend
KC_SMTP_PASSWORD=${RESEND_API_KEY}

# ── Stripe LIVE (leave empty until you are ready to take real money; sign-up then stays closed) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=price_1UexwLAPelOwzevDIymU46pk
STRIPE_PRICE_LABEL=EUR 49.99 per month
