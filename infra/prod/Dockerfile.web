# Builds the Office web app (Vite) and serves it with Caddy (automatic HTTPS), together with the reverse proxy rules.
# Build from the repository root:  docker build -f infra/prod/Dockerfile.web -t office-web .
FROM node:22-alpine AS build
ARG VITE_API_URL
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID=office-web
ENV VITE_API_URL=$VITE_API_URL VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
RUN corepack enable
WORKDIR /src
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @office/web build

FROM caddy:2-alpine
COPY --from=build /src/apps/web/dist /srv
COPY infra/prod/Caddyfile /etc/caddy/Caddyfile
