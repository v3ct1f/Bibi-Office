# Owner role: runs migrations only
DATABASE_URL=postgres://office_owner:office_owner@localhost:5432/office
# App role: no BYPASSRLS, used by API
DATABASE_URL_APP=postgres://office_app:office_app@localhost:5432/office
# Relay role: reads/marks outbox across tenants
DATABASE_URL_RELAY=postgres://office_relay:office_relay@localhost:5432/office
OIDC_ISSUER=http://localhost:8080/realms/office
OIDC_AUDIENCE=office-api
API_KEY_PEPPER=change-me-32-bytes-min-random-string
NATS_URL=nats://localhost:4222
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Web app address for links in emails (defaults to the first CORS origin).
# APP_URL=https://office.example.com
# Program owners (comma-separated emails) and whether people may create their own business.
PLATFORM_ADMIN_EMAILS=you@example.com
SELF_SIGNUP=false
# Platform email for invitations. Without it, admins copy the invite link and send it themselves.
# MAIL_SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Office <no-reply@example.com>"
TURBO_TELEMETRY_DISABLED=1
# 32 random bytes, base64 (openssl rand -base64 32). Seals module secrets + webhook secrets. KMS/Vault in prod.
SECRETS_KEY=
# Unset => in-process workflow runner (no durable timers). Set to use Temporal.
TEMPORAL_ADDRESS=localhost:7233
# Dev only: allow webhooks/http actions to private IPs. Refused when NODE_ENV=production.
WEBHOOK_ALLOW_PRIVATE=false

# Paid sign-up with Stripe (see docs/stripe-setup.md). Leave empty to keep sign-up closed.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_PRICE_LABEL=EUR 29 per month
