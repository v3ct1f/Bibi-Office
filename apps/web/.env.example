# Web app (Vite). Defaults target the local dev stack: pnpm dev:oidc + pnpm dev:local --port 3100 + pnpm dev:web
# (if you run the API with pnpm dev:api instead, it listens on :3000: set VITE_API_URL=http://localhost:3000)
VITE_API_URL=http://localhost:3100
VITE_OIDC_ISSUER=http://localhost:8081/realms/office
VITE_OIDC_CLIENT_ID=office-web
