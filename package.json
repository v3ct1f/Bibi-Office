{
  "name": "office",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @office/db migrate",
    "dev:api": "pnpm --filter @office/api dev",
    "dev:worker": "pnpm --filter @office/worker dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "modules:install": "pnpm --filter @office/modules install-modules",
    "dev:web": "pnpm --filter @office/web dev",
    "dev:oidc": "pnpm --filter @office/api dev:oidc",
    "e2e": "pnpm --filter @office/web e2e",
    "dev:local": "pnpm --filter @office/api dev:local",
    "dev:local-worker": "pnpm --filter @office/worker dev:local"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.20.6",
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
